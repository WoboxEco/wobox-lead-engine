# Supabase (crear proyecto en https://supabase.com/dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Apollo.io (https://app.apollo.io/settings/integrations/api)
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/v1

# Apify (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=
APIFY_ACTOR_GOOGLE_MAPS=compass/crawler-google-places
APIFY_ACTOR_INSTAGRAM=apify/instagram-profile-scraper

# HubSpot (Private App token)
HUBSPOT_PRIVATE_APP_TOKEN=

# Calendly (webhook signing key)
CALENDLY_SIGNING_KEY=

# Email (Google Workspace SMTP — App Password en https://myaccount.google.com/apppasswords)
GMAIL_USER=sebastian@wobox.ar
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Sebastián | Wobox
EMAIL_DAILY_LIMIT=40
# El mismo App Password sirve para leer respuestas por IMAP (imap.gmail.com, IMAP habilitado en Gmail)

# Cron diario (Vercel Cron manda Authorization: Bearer $CRON_SECRET). Generar con: openssl rand -hex 32
CRON_SECRET=
# Presupuesto de tiempo del cron en ms (Hobby: 10s por default)
CRON_TIME_BUDGET_MS=9000

# App
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development
